{
  "name": "@heorot/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Meadhall Android app (Capacitor wrapper around the web app)",
  "scripts": {
    "build:web": "npm --prefix ../web run build -- --base ./ --outDir ../mobile/www --emptyOutDir",
    "build": "npm run build:web && cap sync android",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
