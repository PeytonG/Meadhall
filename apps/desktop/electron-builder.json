{
  "appId": "io.github.peytong.meadhall",
  "productName": "Meadhall",
  "asar": true,
  "asarUnpack": "**/*.node",
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "resetAdHocDarwinSignature": true
  },
  "directories": {
    "output": "dist-electron"
  },
  "icon": "assets/icon.png",
  "publish": [
    {
      "provider": "github",
      "owner": "PeytonG",
      "repo": "Meadhall",
      "releaseType": "draft"
    }
  ],
  "files": [
    "dist/electron/**/*",
    "web/**/*",
    "assets/**/*",
    "package.json"
  ],
  "afterPack": "scripts/electron-builder-after-pack.cjs",
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Meadhall-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.social-networking",
    "hardenedRuntime": true,
    "gatekeeperAssess": true,
    "strictVerify": true,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Meadhall uses your microphone in voice channels and calls.",
      "NSCameraUsageDescription": "Meadhall uses your camera when you turn it on in a call."
    },
    "mergeASARs": true
  },
  "dmg": {},
  "linux": {
    "target": [
      "AppImage",
      "rpm",
      "deb"
    ],
    "category": "Network",
    "executableName": "meadhall"
  },
  "rpm": {
    "artifactName": "Meadhall-${version}-${arch}.${ext}",
    "depends": [
      "gtk3",
      "libnotify",
      "nss",
      "libXScrnSaver",
      "(libXtst or libXtst6)",
      "xdg-utils",
      "at-spi2-core",
      "(libuuid or libuuid1)",
      "alsa-lib",
      "mesa-libgbm",
      "libdrm"
    ]
  },
  "appImage": {
    "artifactName": "Meadhall-${version}-${arch}.${ext}"
  },
  "deb": {
    "artifactName": "Meadhall-${version}-${arch}.${ext}",
    "depends": [
      "libgtk-3-0t64 | libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64 | libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1",
      "libdrm2"
    ]
  }
}
