{
  "appId": "io.github.peytong.meadhall",
  "productName": "Meadhall",
  "asar": true,
  "asarUnpack": "**/*.node",
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "resetAdHocDarwinSignature": true
  },
  "directories": {
    "output": "dist-electron"
  },
  "icon": "assets/icon.png",
  "publish": [
    {
      "provider": "github",
      "owner": "PeytonG",
      "repo": "Meadhall",
      "releaseType": "draft"
    }
  ],
  "files": [
    "dist/electron/**/*",
    "web/**/*",
    "assets/**/*",
    "package.json"
  ],
  "afterPack": "scripts/electron-builder-after-pack.cjs",
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Meadhall-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.social-networking",
    "hardenedRuntime": true,
    "gatekeeperAssess": true,
    "strictVerify": true,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "mergeASARs": true
  },
  "dmg": {},
  "linux": {
    "target": [
      "AppImage",
      "rpm"
    ],
    "category": "Network",
    "executableName": "meadhall"
  },
  "rpm": {
    "artifactName": "Meadhall-${version}-${arch}.${ext}"
  },
  "appImage": {
    "artifactName": "Meadhall-${version}-${arch}.${ext}"
  }
}
